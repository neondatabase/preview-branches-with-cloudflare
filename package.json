{
  "name": "preview-branches-with-cloudflare",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "cf-typegen": "wrangler types && prettier --write worker-configuration.d.ts",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate --config=./src/lib/db/config.ts",
    "db:migrate": "drizzle-kit migrate --config=./src/lib/db/config.ts",
    "db:studio": "drizzle-kit studio --config=./src/lib/db/config.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "pg": "^8.21.0"
  }
}
